# /etc/default/autodeploy — environment for the AutoDeploy systemd unit.
#
# Edit, copy to /etc/default/autodeploy, and `systemctl restart autodeploy`.
# Production deployments should set AUTODEPLOY_DEV=false so the server
# refuses cleartext HTTP on non-loopback addresses.

# --- Bind addresses --------------------------------------------------
# Pick the surfaces you need. Empty = disabled.
AUTODEPLOY_HTTP_ADDR=127.0.0.1:8080
AUTODEPLOY_HTTPS_ADDR=0.0.0.0:443
AUTODEPLOY_TFTP_ADDR=:69

# --- TLS for the HTTPS listener -------------------------------------
# Required in production. In dev mode a self-signed cert is auto-
# generated under $AUTODEPLOY_DATA_DIR/tls/.
#AUTODEPLOY_TLS_CERT=/etc/autodeploy/tls/server.crt
#AUTODEPLOY_TLS_KEY=/etc/autodeploy/tls/server.key

# --- Operating mode --------------------------------------------------
# false = production: HTTPS required for non-loopback HTTP, no auto
# dev-cert generation.
AUTODEPLOY_DEV=false

# --- Secrets-at-rest key --------------------------------------------
# Hex-encoded 32-byte key. Generate once:
#   openssl rand -hex 32
# Back up the value off-host. Losing it makes escrowed BitLocker PINs
# and recovery keys unrecoverable.
# Empty = auto-generate to $AUTODEPLOY_DATA_DIR/secrets-key.bin.
#AUTODEPLOY_SECRETS_KEY=

# --- Active Directory (optional) ------------------------------------
# Leave AUTODEPLOY_AD_URL empty to disable AD integration entirely.
#AUTODEPLOY_AD_URL=ldaps://dc.corp.example:636
#AUTODEPLOY_AD_BIND_DN=CN=autodeploy,OU=Service Accounts,DC=corp,DC=example
#AUTODEPLOY_AD_BIND_PASSWORD=changeme
#AUTODEPLOY_AD_SEARCH_BASE=DC=corp,DC=example
#AUTODEPLOY_AD_SKIP_TLS_VERIFY=false

# --- Scale knobs ----------------------------------------------------
# Caps concurrent /payload/* streams. Raise on production hosts with
# bigger fd budget; lower if mirrors are absorbing most load.
AUTODEPLOY_PAYLOAD_MAX_IN_FLIGHT=64

# --- Retention ------------------------------------------------------
# Auto-prune log_event older than N days. 0 = never.
AUTODEPLOY_LOG_RETENTION_DAYS=90
