# autodeploy.env -- environment for the AutoDeploy Windows service.
#
# Edit this file in place, then re-run install-windows.ps1 -ApplyEnv
# (or run install-windows.ps1 fresh -- it picks up the file automatically).
# The installer writes the values into the service's environment block
# in HKLM\SYSTEM\CurrentControlSet\Services\autodeploy\Environment so
# the Windows Service Control Manager hands them to the binary at start
# time, exactly the way /etc/default/autodeploy works on Linux.
#
# Lines starting with # are comments. Blank lines are ignored.

# --- Bind addresses --------------------------------------------------
# Pick the surfaces you need. Empty value = disabled. Three supported
# deployment shapes:
#
#   1. HTTPS only:        HTTP_ADDR=         HTTPS_ADDR=0.0.0.0:443
#      Operator supplies a TLS cert/key below. Recommended.
#
#   2. HTTP only:         HTTP_ADDR=0.0.0.0:8080  HTTPS_ADDR=
#      Permitted; the server logs a clearly-marked warning at
#      startup when it binds cleartext on a non-loopback address
#      so the choice is auditable. Use this when a reverse proxy
#      (IIS / nginx / Caddy) terminates TLS upstream, or for
#      trusted-network LAN deployments where TLS isn't worth
#      managing.
#
#   3. Both:              HTTP_ADDR=127.0.0.1:8080  HTTPS_ADDR=0.0.0.0:443
#      Loopback HTTP for local-only health checks; HTTPS for
#      everything else.
# Default shape: HTTP on all interfaces. Reach the portal at
# http://<this-host>:8080/portal/. To enable HTTPS, uncomment the
# HTTPS_ADDR line below (and optionally point AUTODEPLOY_TLS_CERT/KEY
# at a CA-signed pair; without them the server auto-generates a
# self-signed cert under %AUTODEPLOY_DATA_DIR%\tls\ and logs a WARN).
AUTODEPLOY_HTTP_ADDR=0.0.0.0:8080
#AUTODEPLOY_HTTPS_ADDR=0.0.0.0:443
AUTODEPLOY_TFTP_ADDR=:69

# --- TLS for the HTTPS listener -------------------------------------
# Optional. If AUTODEPLOY_HTTPS_ADDR is set and these are empty, the
# server auto-generates a self-signed cert under %AUTODEPLOY_DATA_DIR%\tls\.
# In production mode it logs a WARN that the cert is self-signed -- set
# these to a CA-signed pair to silence the warning.
#AUTODEPLOY_TLS_CERT=C:\ProgramData\AutoDeploy\tls\server.crt
#AUTODEPLOY_TLS_KEY=C:\ProgramData\AutoDeploy\tls\server.key

# --- Operating mode --------------------------------------------------
# false = production: no auto-generated dev TLS cert, no debug-only
# logging niceties. HTTP is still a valid binding choice -- the
# server only emits a warning, never refuses to start.
AUTODEPLOY_DEV=false

# --- Data directory --------------------------------------------------
# Where SQLite, payload blobs, iPXE static files and the bootstrap-
# admin file live. Default below matches install-windows.ps1.
AUTODEPLOY_DATA_DIR=C:\ProgramData\AutoDeploy

# --- Secrets-at-rest key --------------------------------------------
# Hex-encoded 32-byte key. Generate once on the install host:
#   [Convert]::ToHexString([System.Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
# Back up the value off-host. Losing it makes the domain-join and
# webhook secrets it protects unrecoverable.
# Empty = auto-generate to %AUTODEPLOY_DATA_DIR%\secrets-key.bin.
#AUTODEPLOY_SECRETS_KEY=

# --- Settings managed through the portal at runtime -----------------
#
# The following are configurable through the portal under:
#   Settings -> Active Directory
#   Settings -> Operational
#
# The env vars below are read ONCE on first start and seed those
# portal-managed settings; after that the portal is the source of
# truth (changing values here later does NOT override what was saved
# through the UI). Leave commented out for a portal-driven install.
#
#AUTODEPLOY_AD_URL=ldaps://dc.corp.example:636
#AUTODEPLOY_AD_BIND_DN=CN=autodeploy,OU=Service Accounts,DC=corp,DC=example
#AUTODEPLOY_AD_BIND_PASSWORD=changeme
#AUTODEPLOY_AD_SEARCH_BASE=DC=corp,DC=example
#AUTODEPLOY_AD_SKIP_TLS_VERIFY=false
#AUTODEPLOY_PAYLOAD_MAX_IN_FLIGHT=128
#AUTODEPLOY_LOG_RETENTION_DAYS=90
